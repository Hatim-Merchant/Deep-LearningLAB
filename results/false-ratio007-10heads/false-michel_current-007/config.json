{
  "dataset": "cifar100",
  "data_root": "data/cifar100",
  "num_tasks": 10,
  "shuffle_classes": false,
  "resume": "",
  "seed": 2025,
  "model": "vit_base_patch16_224.augreg_in21k",
  "head_dim_type": "task_classes",
  "logit_type": "head_out",
  "logit_scale": 4.605170249938965,
  "logit_scale_trainable": false,
  "seperate_head": true,
  "pretrained_ignore_patterns": [],
  "refine_head": true,
  "transform_type": "autoaug",
  "interp_mode": "bicubic",
  "prob_cutmixup": 0,
  "cutmixup_stopepoch": 999,
  "epochs": 5,
  "batch_size": 100,
  "workers": 16,
  "eval_workers": 2,
  "expand_times": 10,
  "temperature": 30,
  "use_amp": true,
  "sample_type": "image",
  "consecutive_training": true,
  "timeout": 30,
  "persistent_workers": false,
  "training_string": [
