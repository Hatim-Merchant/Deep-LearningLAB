  "head_selection": "michel_current",
  "weight_decay": 5e-05,
  "lr_sch": "multistep",
  "warmup_epochs": 0,
  "min_lr": 1e-05,
  "decay_milestones": [
    5,
    8
  ],
  "decay_epochs": 1000,
  "decay_rate": 0.1,
  "show_bar": false,
  "print_model": false,
  "log_dir": "./logs2/false-false-michel_current-007"
